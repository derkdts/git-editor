{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitEditor",
  "version": "0.1.0",
  "identifier": "com.example.giteditor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Git Editor",
        "width": 1100,
        "height": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
